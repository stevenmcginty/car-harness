# Python
.venv/
__pycache__/
*.pyc

# Local state -- machine-specific config and pairing data, never shared
adapters.json
paired_devices.json
modules_store/*
!modules_store/.gitkeep

# Private research / notes -- local only, never pushed to the public repo
docs/private/

# Android build machinery and caches
android/local.properties
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/core/build/
android/.idea/

# Third-party APK teardown -- reference material, not ours to redistribute.
android/autel/

# Server logs. Noise, and they can carry VINs.
*.log
*.err
server.log.err
