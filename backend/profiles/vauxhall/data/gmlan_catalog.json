    "CC": "Base model part number",
    "D0": "Boot software alpha code",
    "D1": "Software module 01 alpha",
    "D2": "Software module 02 alpha",
    "D3": "Software module 03 alpha",
    "D4": "Software module 04 alpha",
    "D5": "Software module 05 alpha",
    "D6": "Software module 06 alpha",
    "D7": "Software module 07 alpha",
    "D8": "Software module 08 alpha",
    "D9": "Software module 09 alpha",
    "DA": "Software module 10 alpha",
    "DB": "End model alpha code",
    "DC": "Base model alpha code",
