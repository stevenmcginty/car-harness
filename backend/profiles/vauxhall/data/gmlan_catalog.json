    "9D": "XML data file alpha code",
    "9F": "Previous tester serials",
    "A0": "Manufacturer enable counter",
    "B0": "ECU diagnostic address",
    "B2": "GM manufacturing data",
    "B4": "Manufacturing traceability",
    "B5": "GM broadcast code",
    "C0": "Boot software part number",
    "C1": "Software module 01",
    "C2": "Software module 02",
    "C3": "Software module 03",
    "C4": "Software module 04",
    "C5": "Software module 05",
    "C6": "Software module 06",
    "C7": "Software module 07",
    "C8": "Software module 08",
    "C9": "Software module 09",
