  "a9_subfunctions": {
    "80": "readStatusOfDTCByDTCNumber",
    "81": "readStatusOfDTCByStatusMask",
    "82": "sendOnChangeDTCCount"
  },
  "aa_subfunctions": {
    "00": "stopSending",
    "01": "sendOneResponse",
    "02": "scheduleAtSlowRate",
    "03": "scheduleAtMediumRate",
    "04": "scheduleAtFastRate"
  },
  "a2_programmed_states": {
    "00": "fully programmed",
    "01": "no op software or cal data",
    "02": "op software present, cal data missing",
    "03": "software present, default or no-start cal present",
    "50": "general memory fault",
    "51": "RAM memory fault",
    "52": "NVRAM memory fault",
    "53": "boot memory failure",
    "54": "flash memory failure",
    "55": "EEPROM memory failure"
  },
  "security_27": {
    "01": "SPS request seed",
    "02": "SPS send key",
    "03": "DeviceControl request seed",
    "04": "DeviceControl send key"
  },
  "dtc_status_bits": {
    "comment": "GMW3110 bits, NOT ISO 14229. Copied from roffe/gocan pkg/gmlan ReadDiagnosticInformation comment (mask 0x12 example).",
    "bits": [
      {"mask": 1, "name": "supported by calibration"},
      {"mask": 2, "name": "current"},
      {"mask": 4, "name": "not passed since cleared"},
      {"mask": 8, "name": "failed since cleared"},
      {"mask": 16, "name": "history"},
      {"mask": 32, "name": "not passed this power-up"},
      {"mask": 64, "name": "current since power-up"},
      {"mask": 128, "name": "warning indicator"}
    ]
  },
  "uudt_dtc": {
    "comment": "gocan ReadDiagnosticInformation subscribes to CAN 0x5E8 after A9 81. Each UUDT payload is [src][dtc_hi][dtc_lo][failure_type][status]. Stream ends on 00 00 00.",
    "can_id": "5E8",
    "end": [0, 0, 0]
  },
  "nrc": {
    "11": "service not supported",
    "12": "sub-function not supported",
    "22": "conditions not correct or request sequence error",
    "31": "request out of range",
    "35": "invalid key",
    "36": "exceeded number of attempts",
    "37": "required time delay not expired",
    "78": "request correctly received - response pending",
    "81": "scheduler full",
    "83": "voltage out of range",
    "85": "general programming failure",
    "89": "device type error",
    "99": "ready for download, DTC stored",
    "E3": "device control limits exceeded"
  }
